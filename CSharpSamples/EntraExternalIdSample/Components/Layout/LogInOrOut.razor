@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3 text-white-50 small">@context.User.Identity?.Name</div>
        <div class="nav-item px-3">
            <form action="authentication/logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@Navigation.BaseUri" />
                <button type="submit" class="nav-link btn btn-link p-0">
                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Sign out
                </button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Sign in / Sign up
            </NavLink>
        </div>
    </NotAuthorized>
</AuthorizeView>
